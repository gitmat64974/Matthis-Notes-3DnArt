THEME=https://raw.githubusercontent.com/gonzalo-d-sales/obsidian-velocity/HEAD/theme.css
BASE_THEME=dark
dgHomeLink=true
dgShowBacklinks=false
dgShowLocalGraph=false
dgShowInlineTitle=true
dgShowFileTree=false
dgEnableSearch=true
dgShowToc=false
dgLinkPreview=true
dgShowTags=false
SITE_NAME_HEADER=3D and Art notes
SITE_MAIN_LANGUAGE=fr
SITE_BASE_URL=https://3dandartnotesmatthis.wiki/
SHOW_CREATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a
SHOW_UPDATED_TIMESTAMP=false
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false
STYLE_SETTINGS_CSS=body.css-settings-manager { --anp-background-image-dark: url("https://i.imgur.com/nLcl4bo.png"); --anp-background-image-light: url("https://images.unsplash.com/photo-1525326551663-02d6b658a07e?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"); --anp-custom-bg-blur-light: 6px; --anp-custom-bg-blur-dark: 0px; --anp-custom-bg-brightness-light: 0.7; --anp-custom-bg-card-fg-opacity-light: 0.4; --anp-custom-bg-brightness-dark: 0.6; --anp-custom-bg-card-fg-opacity-dark: 0.4; --file-line-width: 43rem; } body.theme-light.css-settings-manager { } body.theme-dark.css-settings-manager { } main.content > header:has(>.garden-banner){padding-top:calc(var(--garden-banner-height, 220px) + 1em)} main.content > header:has(>.garden-banner) > .garden-banner{top:-28px;left:50%;width:100vw;transform:translateX(-50%);border-radius:0;height:calc(var(--garden-banner-height, 220px) + 28px)} main.content > header:has(>.garden-banner) > .garden-banner.garden-banner-fade{background-image:linear-gradient(to bottom, transparent 0%, transparent 55%, var(--background-primary) 100%), var(--garden-banner-image);background-size:100% 100%, cover} html, body{overflow-x:clip}/*garden-banner-fullwidth-fix*//*accent-bg-violetrose-fix*/body{background-color:rgba(24,23,30,1) !important;background-image:linear-gradient(rgba(20,19,26,0.55),rgba(20,19,26,0.55)),url(https://i.imgur.com/krWp71D.png) !important;background-size:cover !important;background-position:center !important;background-attachment:fixed !important}nav.navbar{background-color:rgba(20,19,26,0.55) !important;backdrop-filter:blur(12px)}main.content{background-color:rgba(24,23,30,0.4);border-radius:12px}article,.markdown-preview-sizer{background-color:transparent !important}body{--anp-custom-bg-brightness-dark:0.78;--anp-custom-bg-blur-dark:0px;--accent-h:284 !important;--accent-s:55% !important;--accent-l:65% !important}main.content > header:has(>.garden-banner) > .garden-banner.garden-banner-fade{background-image:linear-gradient(to bottom,transparent 0%,transparent 50%,rgba(24,23,30,0.4) 100%),var(--garden-banner-image);background-size:100% 100%,cover} :root{--highlight:rgba(255,255,255,1);--primary:rgba(170,170,170,1);--dark:rgba(51,51,51,1)}.daily{color:var(--highlight);background-color:var(--dark);--text-normal:var(--highlight);--text-muted:var(--highlight);--text-faint:var(--highlight);--hr-color:var(--primary);--blockquote-border-color:var(--primary);--interactive-accent:var(--primary);--checkbox-color:var(--primary);--checkbox-marker-color:var(--dark);--checkbox-color-hover:var(--highlight);--checkbox-border-color:var(--highlight);--list-marker-color:var(--highlight);--code-background:black;--code-normal:var(--primary);--background-modifier-border:color-mix(in srgb,var(--highlight) 60%,transparent);--background-modifier-hover:color-mix(in srgb,var(--highlight) 60%,transparent)}main.content :is(h1,h2,h3,h4,h5,h6){text-align:center;font-family:var(--font-text-theme,var(--font-text))}main.content h1{color:var(--primary);font-size:42px;padding:0 !important}main.content h2{color:var(--highlight);font-size:36px;font-style:italic;padding:0 !important}main.content h3{color:rgba(247,220,219,1);font-size:30px;font-style:italic;padding-top:0}main.content h4{color:rgba(252,238,207,1);font-size:26px;font-weight:500;font-style:italic;margin-bottom:0;padding:0}main.content h5{color:rgba(219,231,201,1);font-size:20px;padding-top:0}main.content h6{color:rgba(224,208,247,1);font-size:16px;padding-top:0}main.content > header h1{color:var(--primary);text-align:center;padding:0 !important}hr{margin-top:20px !important;margin-bottom:20px !important}main.content img{display:block !important;margin-left:auto !important;margin-right:auto !important}/*centered-titles*/
STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-windows is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen is-maximized css-settings-manager outliner-plugin-dnd pp-pill-padding-all base-tags-style velocity velocity-gray anp-background-image-toggle anp-theme-ext-dark ctp-nord-light ctp-everforest-dark is-focused
USE_FULL_RESOLUTION_IMAGES=true
dgPassFrontmatter=false